diff --git a/engine/common/launcher.c b/engine/common/launcher.c
index 70adc33..77404ef 100644
--- a/engine/common/launcher.c
+++ b/engine/common/launcher.c
@@ -15,6 +15,8 @@ GNU General Public License for more details.
 
 #if XASH_ENABLE_MAIN
 #include "build.h"
+#include <stdio.h>
+#include <string.h>
 #include "common.h"
 
 #if XASH_SDLMAIN
@@ -41,10 +43,98 @@ int main( int argc, char **argv )
 #elif XASH_IOS
 	IOS_LaunchDialog();
 	szArgc = IOS_GetArgs( &szArgv );
+#elif XASH_PS5
+	// ps5-opengl's SDL2 "G19" video driver hard-rejects any GL context
+	// that isn't exactly 3.3 Core with default flags (see
+	// integration/SDL2/SDL_ps5g19.c create_context(): "G19 SDL requires
+	// one unshared OpenGL 3.3 Core context with default flags" -- any
+	// other request returns NULL from SDL_GL_CreateContext, which the
+	// ref_gl backend doesn't recover from, crashing before the first
+	// frame). ref/gl only requests that exact profile when launched with
+	// -glcore; a native PS5 title has no command line to pass that flag
+	// on, so force it here, the same way PSVita forces its own required
+	// flags above.
+	{
+		static char *ps5_argv[64];
+		// -dev 2 / -console: debug builds mirror the whole console to klogsrv
+		// -gl2shim: Core profile has no fixed-function GL; ref_gl's shim emulates it
+		static const char *forced_args[] = { "-glcore", "-gl2shim", "-dev", "2", "-console" };
+		int i, j;
+
+		// argv[0] must be the program name: Sys_CheckParm() scans from index 1.
+		// A normal launch passes argv[0] = "/app0/eboot.bin", but a relaunch
+		// through sceSystemServiceLoadExec passes only the user arguments
+		// ("-game bshift ..."), which would hide "-game" at index 0.
+		i = 0;
+		ps5_argv[i++] = "/app0/eboot.bin";
+		for( j = ( argc > 0 && argv[0] && argv[0][0] != '-' ) ? 1 : 0; j < argc && i < 58; j++ )
+			ps5_argv[i++] = argv[j];
+		for( j = 0; j < (int)( sizeof( forced_args ) / sizeof( forced_args[0] )); j++ )
+			ps5_argv[i++] = (char *)forced_args[j];
+
+		// Extra args from a writable file (no command line on PS5): lets us try
+		// engine/renderer switches over FTP without rebuilding the eboot.
+		{
+			static char extra[1024];
+			FILE *fp = fopen( "/download0/xash_args.txt", "r" );
+			if( !fp )
+				fp = fopen( "/app0/xash_args.txt", "r" );
+			if( fp )
+			{
+				size_t n = fread( extra, 1, sizeof( extra ) - 1, fp );
+				char *tok;
+				fclose( fp );
+				extra[n] = 0;
+				for( tok = strtok( extra, " \t\r\n" ); tok && i < 62; tok = strtok( NULL, " \t\r\n" ))
+					ps5_argv[i++] = tok;
+			}
+		}
+		// game chosen with "Change game" before the relaunch (see Sys_NewInstance)
+		{
+			static char nextgame[64];
+			qboolean has_game = false;
+			FILE *fp = fopen( "/download0/xash_nextgame.txt", "r" );
+
+			for( j = 0; j < i; j++ )
+				if( ps5_argv[j] && !strcmp( ps5_argv[j], "-game" ))
+					has_game = true;
+			if( fp )
+			{
+				size_t n = fread( nextgame, 1, sizeof( nextgame ) - 1, fp );
+				fclose( fp );
+				remove( "/download0/xash_nextgame.txt" );
+				nextgame[n] = 0;
+				nextgame[strcspn( nextgame, " \t\r\n" )] = 0;
+				if( nextgame[0] && !has_game && i < 61 )
+				{
+					ps5_argv[i++] = "-game";
+					ps5_argv[i++] = nextgame;
+				}
+			}
+		}
+		ps5_argv[i] = NULL;
+		szArgc = i;
+		szArgv = ps5_argv;
+	}
 #else
 	szArgc = argc;
 	szArgv = argv;
 #endif // XASH_PSVITA
+#if XASH_PS5
+	{
+		// Native titles must never return from main()/call exit(): the CRT's
+		// exit path raises SIGSYS and the system reports a crash. Ask the
+		// system to close the app instead (same service as the game-switch
+		// relaunch), and keep the thread parked if it does not act at once.
+		extern int sceSystemServiceLoadExec( const char *path, char *const argv[] );
+		extern unsigned int sleep( unsigned int seconds );
+		int ret = Host_Main( szArgc, szArgv, XASH_GAMEDIR, 0, Sys_ChangeGame );
+		printf( "[XASH] Host_Main returned %d, closing the application\n", ret );
+		sceSystemServiceLoadExec( "exit", NULL );
+		for( ;; )
+			sleep( 1 );
+	}
+#endif
 	return Host_Main( szArgc, szArgv, XASH_GAMEDIR, 0, Sys_ChangeGame );
 }
 #endif // XASH_ENABLE_MAIN
