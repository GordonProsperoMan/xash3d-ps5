+		// stderr goes nowhere on a native title: mirror to klogsrv with the
+		// faulting RIP and a frame-pointer walk so addr2line can resolve it.
+		extern int sceKernelDebugOutText( int channel, const char *text );
+		extern char __executable_start[] __attribute__((weak));
+		ucontext_t *uc = (ucontext_t *)context;
+		char line[256];
+		uintptr_t rip = (uintptr_t)uc->uc_mcontext.mc_rip;
+		uintptr_t rbp = (uintptr_t)uc->uc_mcontext.mc_rbp;
+		uintptr_t base = (uintptr_t)__executable_start;
+		sceKernelDebugOutText( 0, "[XASH] CRASH " );
+		sceKernelDebugOutText( 0, crash_message );
+		Q_snprintf( line, sizeof( line ), "[XASH] CRASH rip=%p (off 0x%lx) rsp=%p rbp=%p base=%p\n",
+			(void *)rip, (unsigned long)( rip - base ), (void *)uc->uc_mcontext.mc_rsp, (void *)rbp, (void *)base );
+		sceKernelDebugOutText( 0, line );
+		// only walk frames that sit inside the faulting thread's stack
+		uintptr_t rsp = (uintptr_t)uc->uc_mcontext.mc_rsp;
+		for( int i = 0; i < 24 && rbp && !( rbp & 7 ) && rbp >= rsp && rbp - rsp < ( 8u << 20 ); i++ )
+		{
+			uintptr_t ret = ((uintptr_t *)rbp)[1];
+			uintptr_t next = ((uintptr_t *)rbp)[0];
+			Q_snprintf( line, sizeof( line ), "[XASH] CRASH #%d %p (off 0x%lx)\n", i, (void *)ret, (unsigned long)( ret - base ));
+			sceKernelDebugOutText( 0, line );
+			if( next <= rbp )
+				break;
+			rbp = next;
+		}
+	}
+#endif
 
 #if XASH_ANDROID
 	__android_log_write( ANDROID_LOG_FATAL, "Xash", crash_message );
diff --git a/engine/platform/ps5/app_heap.c b/engine/platform/ps5/app_heap.c
new file mode 100644
index 0000000..68e51d1
--- /dev/null
+++ b/engine/platform/ps5/app_heap.c
@@ -0,0 +1,273 @@
+// PS5 OpenGL - OpenGL implementation for PlayStation 5.
+// Copyright (C) 2026 BlackBearReloaded
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/* Shared native-app allocator integration, originally used by the CTS runner. */
+#include <errno.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+
+void *__real_malloc(size_t size);
+void *__real_calloc(size_t count, size_t size);
+void *__real_realloc(void *address, size_t size);
+void __real_free(void *address);
+int __real_posix_memalign(void **address, size_t alignment, size_t size);
+size_t __real_malloc_usable_size(const void *address);
+
+void *sceLibcMspaceCreate(const char *name, void *base, size_t size,
+                          unsigned flags);
+void *sceLibcMspaceMalloc(void *mspace, size_t size);
+void *sceLibcMspaceCalloc(void *mspace, size_t count, size_t size);
+void *sceLibcMspaceRealloc(void *mspace, void *address, size_t size);
+void sceLibcMspaceFree(void *mspace, void *address);
+int sceLibcMspacePosixMemalign(void *mspace, void **address, size_t alignment,
+                              size_t size);
+size_t sceLibcMspaceMallocUsableSize(const void *address);
+int64_t sceKernelGetDirectMemorySize(void);
+int32_t sceKernelAllocateDirectMemory(int64_t search_start, int64_t search_end,
+                                     size_t length, size_t alignment,
+                                     int memory_type, int64_t *physical_start);
+int32_t sceKernelMapDirectMemory(void **address, size_t length, int protection,
+                                int flags, int64_t physical_start, size_t alignment);
+
+/* ponytail: 128 MiB process-lifetime heap by default; revisit the budget only
+ * for measured application needs. Do not unmap underneath late C++ destructors.
+ * A title may define ps5_opengl_heap_size to reserve more (the CTS runner keeps
+ * every test case object alive); smaller sizes are tried if mapping fails. */
+__attribute__((weak)) const size_t ps5_opengl_heap_size = 128u * 1024u * 1024u;
+/* A title may define ps5_opengl_heap_zero_fill as 1: malloc, posix_memalign and
+ * the growth of realloc then return zero-filled memory, so code that reads heap
+ * memory it never wrote behaves the same on every run. */
+__attribute__((weak)) const int ps5_opengl_heap_zero_fill = 0;
+static size_t ps5_heap_size;
+#define PS5_OPENGL_HEAP_SIZE ps5_heap_size
+
+static atomic_int ps5_heap_state;
+static void *ps5_heap_base;
+static void *ps5_heap_mspace;
+/* Owned-heap usable bytes only: not GPU mappings, foreign heaps or process RSS.
+ * Relaxed snapshots are observations, not an allocator synchronization fence. */
+static atomic_size_t ps5_heap_live_bytes, ps5_heap_peak_bytes, ps5_heap_blocks;
+static atomic_size_t ps5_heap_failures, ps5_heap_ambiguous_zero_reallocs;
+
+static void ps5_heap_resize_stats(size_t before, size_t after) {
+  size_t live = after >= before
+      ? atomic_fetch_add_explicit(&ps5_heap_live_bytes, after - before,
+                                  memory_order_relaxed) + after - before
+      : atomic_fetch_sub_explicit(&ps5_heap_live_bytes, before - after,
+                                  memory_order_relaxed) - (before - after);
+  size_t peak = atomic_load_explicit(&ps5_heap_peak_bytes, memory_order_relaxed);
+  while (live > peak && !atomic_compare_exchange_weak_explicit(
+      &ps5_heap_peak_bytes, &peak, live, memory_order_relaxed, memory_order_relaxed)) {}
+}
+
+/* Weak: host builds of this file have no libkernel. */
+int sceKernelDebugOutText(int channel, const char *text) __attribute__((weak));
+void __wrap_free(void *address);
+
+static void *ps5_heap_record_allocation(void *address, size_t size) {
+  const int nonzero = size != 0;
+  if (address) {
+    ps5_heap_resize_stats(0, sceLibcMspaceMallocUsableSize(address));
+    atomic_fetch_add_explicit(&ps5_heap_blocks, 1, memory_order_relaxed);
+  } else if (nonzero) {
+    if (atomic_fetch_add_explicit(&ps5_heap_failures, 1, memory_order_relaxed) < 8 &&
+        sceKernelDebugOutText) {
+      char line[128];
+      snprintf(line, sizeof(line),
+               "[ps5-opengl-heap] mspace refused %zu bytes (live %zu); using the libc heap\n",
+               size, atomic_load_explicit(&ps5_heap_live_bytes, memory_order_relaxed));
+      sceKernelDebugOutText(0, line);
+    }
+  }
+  return address;
+}
+
+static int ps5_heap_ready(void) {
+  int state = atomic_load_explicit(&ps5_heap_state, memory_order_acquire);
+  if (state == 2)
+    return 1;
+  if (state != 0)
+    return 0;
+
+  int expected = 0;
+  if (!atomic_compare_exchange_strong_explicit(
+          &ps5_heap_state, &expected, 1, memory_order_acq_rel,
+          memory_order_acquire))
+    return expected == 2;
+
+  void *base = MAP_FAILED;
+  /* Flexible memory holds only a few hundred MiB; a larger heap comes from
+   * CPU-cached direct memory (the driver's own memory type), mapped CPU-only. */
+  if (ps5_opengl_heap_size > (128u << 20)) {
+    int64_t physical = 0;
+    void *mapped = NULL;
+    const size_t alignment = 2u << 20;
+    const size_t size = (ps5_opengl_heap_size + alignment - 1) & ~(alignment - 1);
+    if (sceKernelAllocateDirectMemory(0, sceKernelGetDirectMemorySize(), size, alignment,
+                                      12, &physical) == 0 &&
+        sceKernelMapDirectMemory(&mapped, size, PROT_READ | PROT_WRITE, 0, physical,
+                                 alignment) == 0 && mapped) {
+      base = mapped;
+      ps5_heap_size = size;
+    }
+  }
+  for (size_t size = ps5_opengl_heap_size; base == MAP_FAILED && size >= (128u << 20);
+       size /= 2) {
+    base = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    if (base != MAP_FAILED)
+      ps5_heap_size = size;
+  }
+  if (base == MAP_FAILED) {
+    atomic_store_explicit(&ps5_heap_state, -1, memory_order_release);
+    return 0;
+  }
+
+  ps5_heap_base = base;
+  ps5_heap_mspace =
+      sceLibcMspaceCreate("PS5-OpenGL", base, PS5_OPENGL_HEAP_SIZE, 0);
+  if (ps5_heap_mspace == NULL) {
+    ps5_heap_base = NULL;
+    munmap(base, PS5_OPENGL_HEAP_SIZE);
+    atomic_store_explicit(&ps5_heap_state, -1, memory_order_release);
+    return 0;
+  }
+
+  atomic_store_explicit(&ps5_heap_state, 2, memory_order_release);
+  return 1;
+}
+
+size_t __wrap_malloc_usable_size(const void *address);
+
+/* Zero from offset to the end of the block, slack beyond the request included. */
+static void *ps5_heap_zero(void *address, size_t offset, size_t size) {
+  if (ps5_opengl_heap_zero_fill && address) {
+    const size_t usable = __wrap_malloc_usable_size(address);
+    if (usable > size)
+      size = usable;
+    if (size > offset)
+      memset((char *)address + offset, 0, size - offset);
+  }
+  return address;
+}
+
+static int ps5_heap_owns(const void *address) {
+  /* Acquire publication before reading non-atomic heap metadata. */
+  if (atomic_load_explicit(&ps5_heap_state, memory_order_acquire) != 2)
+    return 0;
+  uintptr_t value = (uintptr_t)address;
+  uintptr_t base = (uintptr_t)ps5_heap_base;
+  return value >= base && value - base < PS5_OPENGL_HEAP_SIZE;
+}
+
+/* When the owned heap is exhausted, allocations continue from the libc heap;
+ * free/realloc route by address, so both heaps can hold live blocks. */
+void *__wrap_malloc(size_t size) {
+  void *result = ps5_heap_ready()
+      ? ps5_heap_record_allocation(sceLibcMspaceMalloc(ps5_heap_mspace, size), size)
+      : NULL;
+  return ps5_heap_zero(result ? result : __real_malloc(size), 0, size);
+}
+
+void *__wrap_calloc(size_t count, size_t size) {
+  void *result = ps5_heap_ready()
+      ? ps5_heap_record_allocation(sceLibcMspaceCalloc(ps5_heap_mspace, count, size),
+                                   count * size)
+      : NULL;
+  return result ? result : __real_calloc(count, size);
+}
+
+void *__wrap_realloc(void *address, size_t size) {
+  if (address == NULL)
+    return __wrap_malloc(size);
+  if (!ps5_heap_owns(address)) {
+    const size_t before = ps5_opengl_heap_zero_fill ? __real_malloc_usable_size(address) : 0;
+    return ps5_heap_zero(__real_realloc(address, size), before, size);
+  }
+  size_t before = sceLibcMspaceMallocUsableSize(address);
+  void *result = sceLibcMspaceRealloc(ps5_heap_mspace, address, size);
+  if (result) {
+    ps5_heap_resize_stats(before, sceLibcMspaceMallocUsableSize(result));
+    ps5_heap_zero(result, before, size);
+  } else if (size) {
+    atomic_fetch_add_explicit(&ps5_heap_failures, 1, memory_order_relaxed);
+    /* Move the block to the libc heap; the original stays valid on failure. */
+    result = __real_malloc(size);
+    if (result) {
+      memcpy(result, address, before < size ? before : size);
+      ps5_heap_zero(result, before, size);
+      __wrap_free(address);
+    }
+  } else
+    /* Preserve platform realloc(p,0) behavior; NULL does not tell us whether
+     * p was freed. Mark the counters inconclusive instead of guessing. */
+    atomic_fetch_add_explicit(&ps5_heap_ambiguous_zero_reallocs, 1, memory_order_relaxed);
+  return result;
+}
+
+void __wrap_free(void *address) {
+  if (ps5_heap_owns(address)) {
+    ps5_heap_resize_stats(sceLibcMspaceMallocUsableSize(address), 0);
+    atomic_fetch_sub_explicit(&ps5_heap_blocks, 1, memory_order_relaxed);
+    sceLibcMspaceFree(ps5_heap_mspace, address);
+  } else
+    __real_free(address);
+}
+
+int __wrap_posix_memalign(void **address, size_t alignment, size_t size) {
+  int result;
+  if (!ps5_heap_ready())
+    result = __real_posix_memalign(address, alignment, size);
+  else {
+    result = sceLibcMspacePosixMemalign(ps5_heap_mspace, address, alignment, size);
+    if (result == 0)
+      ps5_heap_record_allocation(*address, size);
+    else if (result == ENOMEM) {
+      atomic_fetch_add_explicit(&ps5_heap_failures, 1, memory_order_relaxed);
+      result = __real_posix_memalign(address, alignment, size);
+    }
+  }
+  if (result == 0)
+    ps5_heap_zero(*address, 0, size);
+  return result;
+}
+
+size_t __wrap_malloc_usable_size(const void *address) {
+  return ps5_heap_owns(address) ? sceLibcMspaceMallocUsableSize(address)
+                                : __real_malloc_usable_size(address);
+}
+
+/* Owned-heap usable bytes, for leak diagnostics in long-running titles. */
+size_t ps5_opengl_heap_live_bytes(void) {
+  return atomic_load_explicit(&ps5_heap_live_bytes, memory_order_relaxed);
+}
+
+void ps5_opengl_heap_stats_print(unsigned iteration) {
+  if (iteration == 0) {
+    int state = atomic_load_explicit(&ps5_heap_state, memory_order_acquire);
+    printf("[ps5-opengl-cts] mspace state=%d base=%p size=%zu\n",
+           state, state == 2 ? ps5_heap_base : NULL, (size_t)PS5_OPENGL_HEAP_SIZE);
+  }
+}
+
+/* The native import converter rejects unresolved weak application symbols.
+ * A diagnostic build's strong definition overrides this default no-op. */
+__attribute__((weak)) void ps5_opengl_gpu_snapshot(const char *phase, unsigned iteration) {
+  (void)phase;
+  (void)iteration;
+}
+void ps5_opengl_heap_snapshot(const char *phase, unsigned iteration) {
+  ps5_opengl_gpu_snapshot(phase, iteration);
+  printf("[ps5-opengl-heap] phase=%s sample=%u state=%d live_bytes=%zu peak_bytes=%zu "
+         "blocks=%zu failures=%zu ambiguous_zero_reallocs=%zu\n", phase, iteration,
+         atomic_load_explicit(&ps5_heap_state, memory_order_acquire),
+         atomic_load_explicit(&ps5_heap_live_bytes, memory_order_relaxed),
+         atomic_load_explicit(&ps5_heap_peak_bytes, memory_order_relaxed),
+         atomic_load_explicit(&ps5_heap_blocks, memory_order_relaxed),
+         atomic_load_explicit(&ps5_heap_failures, memory_order_relaxed),
+         atomic_load_explicit(&ps5_heap_ambiguous_zero_reallocs, memory_order_relaxed));
+}
diff --git a/engine/platform/ps5/in_ps5.c b/engine/platform/ps5/in_ps5.c
new file mode 100644
index 0000000..5814b00
--- /dev/null
+++ b/engine/platform/ps5/in_ps5.c
@@ -0,0 +1,267 @@
+/*
+in_ps5.c - PS5 system on-screen keyboard (sceImeDialog) for text input
+Copyright (C) 2026 XashPS5 port
+
+This program is free software: you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation, either version 3 of the License, or
+(at your option) any later version.
+
+ps5-opengl's SDL2 build excludes SDL's video/ps5 keyboard/IME sources, so
+SDL_StartTextInput() does nothing on PS5. Reimplement it the same way the
+PSVita port does: open the system IME dialog whenever the engine enables text
+input (console, chat, menu edit fields) and inject the result as characters.
+Struct layout matches SDL's src/video/ps5/SDL_ps5keyboard.c (PS5 homebrew).
+*/
+
+#include "common.h"
+#include "client.h"
+#include "platform.h"
+#include "keydefs.h"
+
+#if XASH_PS5
+
+#include <string.h>
+#include <stdint.h>
+
+typedef uint16_t ime_wchar_t; // PS5 wchar_t is 16-bit (UTF-16)
+
+typedef int (*SceImeTextFilter)( ime_wchar_t *, uint32_t *, const ime_wchar_t *, uint32_t );
+
+typedef struct
+{
+	int              userId;
+	int              type;               // 0 default, 1 basic latin, 2 url, 3 mail, 4 number
+	uint64_t         supportedLanguages;
+	int              enterLabel;         // 0 default, 1 send, 2 search, 3 go
+	int              inputMethod;
+	SceImeTextFilter filter;
+	uint32_t         option;
+	uint32_t         maxTextLength;
+	ime_wchar_t     *inputTextBuffer;
+	float            posx;
+	float            posy;
+	int              halign;
+	int              valign;
+	const ime_wchar_t *placeholder;
+	const ime_wchar_t *title;
+	int8_t           reserved[16];
+} ps5_ime_param_t;
+
+typedef struct
+{
+	int    outcome; // 0 ok, 1 cancelled, 2 aborted
+	int8_t reserved[12];
+} ps5_ime_result_t;
+
+enum { IME_STATUS_NONE, IME_STATUS_RUNNING, IME_STATUS_FINISHED };
+
+// libSceImeDialog is NOT mapped by the loader for native titles even when it is
+// listed in DT_NEEDED (the crash log module list lacks it, and the first call
+// jumped to rip=1). Load it explicitly and resolve the entry points by hand;
+// if anything fails, text input simply stays disabled instead of crashing.
+int sceKernelLoadStartModule( const char *path, size_t argc, const void *argv, uint32_t flags, void *opt, int *res );
+int sceKernelDlsym( int handle, const char *symbol, void **addr );
+int sceSysmoduleLoadModule( uint16_t id );
+
+static int ( *p_sceImeDialogInit )( const ps5_ime_param_t *param, void *extended );
+static int ( *p_sceImeDialogGetStatus )( void );
+static int ( *p_sceImeDialogGetResult )( ps5_ime_result_t *result );
+static int ( *p_sceImeDialogTerm )( void );
+#define sceImeDialogInit      p_sceImeDialogInit
+#define sceImeDialogGetStatus p_sceImeDialogGetStatus
+#define sceImeDialogGetResult p_sceImeDialogGetResult
+#define sceImeDialogTerm      p_sceImeDialogTerm
+
+static int ime_lib_state; // 0 untried, 1 ok, -1 unavailable
+
+static qboolean IME_LoadLibrary( void )
+{
+	static const char *paths[] =
+	{
+		"/system/common/lib/libSceImeDialog.sprx",
+		"/system_ex/common_ex/lib/libSceImeDialog.sprx",
+		"libSceImeDialog.sprx",
+	};
+	int handle = -1, ret;
+
+	if( ime_lib_state )
+		return ime_lib_state > 0;
+	ime_lib_state = -1;
+
+	// common dialog first (IME dialog depends on it); 0x0095/0x0096 are the
+	// SceSysmodule ids for CommonDialog / ImeDialog
+	ret = sceSysmoduleLoadModule( 0x0095 );
+	Con_Reportf( "IME: sysmodule CommonDialog -> 0x%x\n", ret );
+	ret = sceSysmoduleLoadModule( 0x0096 );
+	Con_Reportf( "IME: sysmodule ImeDialog -> 0x%x\n", ret );
+
+	for( size_t i = 0; i < sizeof( paths ) / sizeof( paths[0] ) && handle < 0; i++ )
+	{
+		handle = sceKernelLoadStartModule( paths[i], 0, NULL, 0, NULL, NULL );
+		Con_Reportf( "IME: load %s -> 0x%x\n", paths[i], handle );
+	}
+	if( handle < 0 )
+	{
+		Con_Printf( S_WARN "IME: libSceImeDialog unavailable, falling back to the built-in on-screen keyboard\n" );
+		Cvar_SetValue( "osk_enable", 1 );
+		return false;
+	}
+
+	{
+		static const char *names[4] = { "sceImeDialogInit", "sceImeDialogGetStatus", "sceImeDialogGetResult", "sceImeDialogTerm" };
+		void **slots[4] = { (void **)&p_sceImeDialogInit, (void **)&p_sceImeDialogGetStatus,
+			(void **)&p_sceImeDialogGetResult, (void **)&p_sceImeDialogTerm };
+		qboolean ok = true;
+
+		for( int i = 0; i < 4; i++ )
+		{
+			*slots[i] = NULL;
+			ret = sceKernelDlsym( handle, names[i], slots[i] );
+			Con_Reportf( "IME: dlsym %s -> 0x%x %p\n", names[i], ret, *slots[i] );
+			if( ret != 0 || !*slots[i] )
+				ok = false;
+		}
+		if( !ok )
+		{
+			Con_Printf( S_WARN "IME: symbol lookup failed, falling back to the built-in on-screen keyboard\n" );
+			Cvar_SetValue( "osk_enable", 1 );
+			return false;
+		}
+	}
+
+	ime_lib_state = 1;
+	Con_Printf( "IME: system keyboard ready\n" );
+	return true;
+}
+
+int sceUserServiceInitialize( void *params );
+int sceUserServiceGetForegroundUser( int *user_id );
+
+#define IME_MAX_TEXT 512
+
+static qboolean    ime_running;
+static qboolean    ime_wanted;    // engine text input is active
+static double      ime_reopen_time;
+static ime_wchar_t ime_text[IME_MAX_TEXT + 1];
+static const ime_wchar_t ime_title[] = { 'X','a','s','h','3','D', 0 };
+
+static void IME_Open( void )
+{
+	ps5_ime_param_t param;
+	int user_id = -1, ret;
+
+	if( ime_running || !IME_LoadLibrary( ))
+		return;
+
+	ret = sceUserServiceInitialize( NULL );
+	if( ret != 0 && ret != (int)0x80960003 ) // already initialised
+		Con_Reportf( S_WARN "IME: sceUserServiceInitialize 0x%x\n", ret );
+
+	ret = sceUserServiceGetForegroundUser( &user_id );
+	if( ret != 0 )
+	{
+		Con_Reportf( S_WARN "IME: no foreground user (0x%x)\n", ret );
+		return;
+	}
+
+	memset( ime_text, 0, sizeof( ime_text ));
+	memset( &param, 0, sizeof( param ));
+	param.userId          = user_id;
+	param.type            = 1; // basic latin: console commands, cvars, IPs
+	param.maxTextLength   = IME_MAX_TEXT;
+	param.inputTextBuffer = ime_text;
+	param.title           = ime_title;
+	param.halign          = 1; // center
+	param.valign          = 2; // bottom
+	param.posx            = 1920.0f;
+	param.posy            = 2100.0f;
+
+	ret = sceImeDialogInit( &param, NULL );
+	if( ret < 0 )
+	{
+		Con_Reportf( S_WARN "IME: sceImeDialogInit failed 0x%x\n", ret );
+		return;
+	}
+	ime_running = true;
+}
+
+static void IME_Close( void )
+{
+	if( !ime_running )
+		return;
+	sceImeDialogTerm();
+	ime_running = false;
+}
+
+void Platform_EnableTextInput( qboolean enable, int x, int y, int w, int h )
+{
+	(void)x; (void)y; (void)w; (void)h;
+
+	ime_wanted = enable;
+	if( enable )
+	{
+		ime_reopen_time = 0.0;
+		IME_Open();
+	}
+	else IME_Close();
+}
+
+static void IME_Deliver( void )
+{
+	for( int i = 0; i < IME_MAX_TEXT && ime_text[i]; i++ )
+	{
+		ime_wchar_t c = ime_text[i];
+		if( c >= 32 && c < 127 )
+			CL_CharEvent( c );
+		else if( c >= 0xA0 && c <= 0xFF )
+			CL_CharEvent( c ); // latin-1 subset; the engine font covers it
+	}
+	// submit the line (console / chat / menu field)
+	Key_Event( K_ENTER, true );
+	Key_Event( K_ENTER, false );
+}
+
+void PS5_InputUpdate( void )
+{
+	int status;
+
+	if( !ime_running )
+	{
+		// console stays open after a command: reopen the keyboard shortly after
+		if( ime_wanted && ime_reopen_time > 0.0 && Platform_DoubleTime() >= ime_reopen_time )
+		{
+			ime_reopen_time = 0.0;
+			IME_Open();
+		}
+		return;
+	}
+
+	status = sceImeDialogGetStatus();
+	if( status != IME_STATUS_FINISHED )
+		return;
+
+	{
+		ps5_ime_result_t result;
+		memset( &result, 0, sizeof( result ));
+		sceImeDialogGetResult( &result );
+		IME_Close();
+
+		if( result.outcome == 0 )
+		{
+			IME_Deliver();
+			// still in a text field (e.g. the console): offer the keyboard again
+			if( ime_wanted )
+				ime_reopen_time = Platform_DoubleTime() + 0.25;
+		}
+		else
+		{
+			// cancelled with Circle: leave the console/field like Escape would
+			ime_wanted = false;
+			Key_Event( K_ESCAPE, true );
+			Key_Event( K_ESCAPE, false );
+		}
+	}
+}
+
+#endif // XASH_PS5
diff --git a/engine/platform/ps5/ps5_vcwd.c b/engine/platform/ps5/ps5_vcwd.c
new file mode 100644
index 0000000..d681bee
--- /dev/null
+++ b/engine/platform/ps5/ps5_vcwd.c
@@ -0,0 +1,230 @@
+/*
+ps5_vcwd.c - virtual current working directory for PS5 native titles
+
+Native (BigApp) titles on PS5 are not allowed to chdir() -- the kernel
+returns EPERM ("Changing directory to /app0 failed: Operation not
+permitted", observed on real hardware). Xash3D's filesystem resolves
+everything relative to the cwd ("./valve/..."), so emulate it: every
+path-taking libc call is redirected (via ld --wrap=<sym>) through these
+wrappers, which prefix relative paths with a process-wide virtual cwd.
+*/
+
+#if XASH_PS5
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <dirent.h>
+#include <unistd.h>
+#include <utime.h>
+#include <sys/stat.h>
+
+static char ps5_vcwd[1024] = "/download0";
+
+static const char *ps5_resolve( const char *path, char *buf, size_t size )
+{
+	if( !path || path[0] == '/' )
+		return path;
+
+	while( path[0] == '.' && path[1] == '/' )
+		path += 2;
+
+	if( !path[0] || ( path[0] == '.' && !path[1] ))
+		snprintf( buf, size, "%s", ps5_vcwd );
+	else
+		snprintf( buf, size, "%s/%s", ps5_vcwd, path );
+
+	return buf;
+}
+
+#define RESOLVE( p ) char p##_buf[1024]; const char *p##_r = ps5_resolve( p, p##_buf, sizeof( p##_buf ))
+
+int __real_stat( const char *path, struct stat *st );
+int __real_lstat( const char *path, struct stat *st );
+int __real_open( const char *path, int flags, ... );
+int __real_access( const char *path, int mode );
+int __real_mkdir( const char *path, mode_t mode );
+int __real_unlink( const char *path );
+int __real_rename( const char *from, const char *to );
+int __real_remove( const char *path );
+int __real_utime( const char *path, const struct utimbuf *times );
+char *__real_realpath( const char *path, char *resolved );
+DIR *__real_opendir( const char *path );
+FILE *__real_fopen( const char *path, const char *mode );
+FILE *__real_freopen( const char *path, const char *mode, FILE *stream );
+
+int __wrap_chdir( const char *path )
+{
+	struct stat st;
+	char tmp[1024];
+	RESOLVE( path );
+
+	if( __real_stat( path_r, &st ) < 0 )
+		return -1;
+
+	if( !S_ISDIR( st.st_mode ))
+	{
+		errno = ENOTDIR;
+		return -1;
+	}
+
+	snprintf( tmp, sizeof( tmp ), "%s", path_r );
+	// strip trailing slashes (keep root "/")
+	for( size_t len = strlen( tmp ); len > 1 && tmp[len - 1] == '/'; len-- )
+		tmp[len - 1] = 0;
+	snprintf( ps5_vcwd, sizeof( ps5_vcwd ), "%s", tmp );
+	return 0;
+}
+
+char *__wrap_getcwd( char *buf, size_t size )
+{
+	if( strlen( ps5_vcwd ) + 1 > size )
+	{
+		errno = ERANGE;
+		return NULL;
+	}
+	memcpy( buf, ps5_vcwd, strlen( ps5_vcwd ) + 1 );
+	return buf;
+}
+
+int __wrap_open( const char *path, int flags, ... )
+{
+	int mode = 0;
+	RESOLVE( path );
+
+	if( flags & O_CREAT )
+	{
+		va_list ap;
+		va_start( ap, flags );
+		mode = va_arg( ap, int );
+		va_end( ap );
+	}
+	return __real_open( path_r, flags, mode );
+}
+
+int __wrap_stat( const char *path, struct stat *st ) { RESOLVE( path ); return __real_stat( path_r, st ); }
+int __wrap_lstat( const char *path, struct stat *st ) { RESOLVE( path ); return __real_stat( path_r, st ); } // native lstat is denied
+int __wrap_access( const char *path, int mode ) { RESOLVE( path ); return __real_access( path_r, mode ); }
+int __wrap_mkdir( const char *path, mode_t mode ) { RESOLVE( path ); return __real_mkdir( path_r, mode ); }
+int __wrap_unlink( const char *path ) { RESOLVE( path ); return __real_unlink( path_r ); }
+int __wrap_remove( const char *path ) { RESOLVE( path ); return __real_remove( path_r ); }
+int __wrap_utime( const char *path, const struct utimbuf *t ) { RESOLVE( path ); return __real_utime( path_r, t ); }
+/*
+ * Native PS5 titles: libc opendir()/readdir() return an empty listing on
+ * real mounts (/app0 lists 0 entries even though stat() succeeds). Read
+ * directories with sceKernelGetdents and a large heap buffer instead,
+ * the same approach as ProsperoEden's headless/native_directory.h.
+ */
+#include <stdlib.h>
+#include <stddef.h>
+#include <stdint.h>
+
+int sceKernelGetdents( int fd, char *buf, int nbytes );
+
+#define PS5_DIRBUF_SIZE 65536
+
+typedef struct ps5_dir_s
+{
+	int fd;
+	int len;
+	int pos;
+	struct dirent ent;
+	char buf[PS5_DIRBUF_SIZE];
+} ps5_dir_t;
+
+DIR *__wrap_opendir( const char *path )
+{
+	ps5_dir_t *d;
+	int fd;
+	RESOLVE( path );
+
+	fd = __real_open( path_r, O_RDONLY | O_DIRECTORY, 0 );
+	if( fd < 0 )
+		return NULL;
+
+	d = calloc( 1, sizeof( *d ));
+	if( !d )
+	{
+		close( fd );
+		errno = ENOMEM;
+		return NULL;
+	}
+	d->fd = fd;
+	return (DIR *)d;
+}
+
+struct dirent *__wrap_readdir( DIR *dirp )
+{
+	ps5_dir_t *d = (ps5_dir_t *)dirp;
+
+	if( !d )
+		return NULL;
+
+	for( ;; )
+	{
+		if( d->pos >= d->len )
+		{
+			d->len = sceKernelGetdents( d->fd, d->buf, sizeof( d->buf ));
+			d->pos = 0;
+			if( d->len <= 0 || d->len > (int)sizeof( d->buf ))
+			{
+				d->len = 0;
+				return NULL;
+			}
+		}
+
+		const size_t name_off = offsetof( struct dirent, d_name );
+		const size_t avail = (size_t)( d->len - d->pos );
+		uint16_t reclen;
+
+		if( avail <= name_off )
+		{
+			d->len = 0;
+			return NULL;
+		}
+
+		memcpy( &reclen, d->buf + d->pos + offsetof( struct dirent, d_reclen ), sizeof( reclen ));
+		if( reclen <= name_off || reclen > avail )
+		{
+			d->len = 0;
+			return NULL;
+		}
+
+		size_t copy = reclen < sizeof( d->ent ) ? reclen : sizeof( d->ent );
+		memset( &d->ent, 0, sizeof( d->ent ));
+		memcpy( &d->ent, d->buf + d->pos, copy );
+		d->ent.d_name[sizeof( d->ent.d_name ) - 1] = 0;
+		d->pos += reclen;
+
+		if( d->ent.d_name[0] == 0 )
+			continue;
+
+		return &d->ent;
+	}
+}
+
+int __wrap_closedir( DIR *dirp )
+{
+	ps5_dir_t *d = (ps5_dir_t *)dirp;
+
+	if( !d )
+		return -1;
+
+	close( d->fd );
+	free( d );
+	return 0;
+}
+FILE *__wrap_fopen( const char *path, const char *mode ) { RESOLVE( path ); return __real_fopen( path_r, mode ); }
+FILE *__wrap_freopen( const char *path, const char *mode, FILE *f ) { RESOLVE( path ); return __real_freopen( path_r, mode, f ); }
+char *__wrap_realpath( const char *path, char *out ) { RESOLVE( path ); return __real_realpath( path_r, out ); }
+
+int __wrap_rename( const char *from, const char *to )
+{
+	RESOLVE( from );
+	RESOLVE( to );
+	return __real_rename( from_r, to_r );
+}
+
+#endif // XASH_PS5
diff --git a/engine/platform/ps5/s_ps5.c b/engine/platform/ps5/s_ps5.c
new file mode 100644
index 0000000..0c74129
--- /dev/null
+++ b/engine/platform/ps5/s_ps5.c
@@ -0,0 +1,238 @@
+/*
+s_ps5.c - native PS5 AudioOut sound backend
+Copyright (C) 2026 XashPS5 port
+
+This program is free software: you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation, either version 3 of the License, or
+(at your option) any later version.
+
+ps5-opengl's SDL2 is built without audio (SDL_AUDIO_DISABLED), so drive
+sceAudioOut directly, the same way ProsperoEden's headless/audio.cpp does:
+48 kHz stereo S16, 256-frame grains, one blocking feeder thread that copies
+from the engine's DMA ring buffer (same model as the SDL2 callback backend).
+*/
+
+#include "common.h"
+#include "platform.h"
+#include "sound.h"
+#include "voice.h"
+
+#if XASH_PS5
+
+#include <pthread.h>
+#include <string.h>
+#include <stdint.h>
+
+int sceAudioOutInit( void );
+int sceAudioOutOpen( int user_id, int type, int index, unsigned int length, unsigned int frequency, unsigned int format );
+int sceAudioOutClose( int handle );
+int sceAudioOutOutput( int handle, const void *samples );
+int sceAudioOutSetVolume( int handle, int flags, const int *volumes );
+
+#define PS5_AUDIO_GRAIN     256       // frames per sceAudioOutOutput call
+#define PS5_AUDIO_RATE      48000
+#define PS5_AUDIO_S16_STEREO 1
+#define PS5_AUDIO_USER_SYSTEM 0xff    // SCE_USER_SERVICE_USER_ID_SYSTEM
+#define PS5_AUDIO_TYPE_MAIN 0
+#define PS5_AUDIO_VOLUME_0DB 32768
+
+static int             ps5_audio_handle = -1;
+static pthread_t       ps5_audio_thread;
+static pthread_mutex_t ps5_audio_lock = PTHREAD_MUTEX_INITIALIZER;
+static volatile int    ps5_audio_running;
+static volatile int    ps5_audio_active;
+static short           ps5_audio_block[PS5_AUDIO_GRAIN * 2];
+
+// The mixer runs at SOUND_DMA_SPEED (44.1 kHz; several engine paths hardcode
+// it), while AudioOut only takes 48 kHz: resample in the feeder thread.
+#define PS5_MIX_RATE  SOUND_DMA_SPEED
+#define PS5_RS_STEP   ((uint32_t)((((uint64_t)PS5_MIX_RATE) << 16) / PS5_AUDIO_RATE))
+#define PS5_IN_MAX    1024
+
+static short    ps5_in[PS5_IN_MAX][2];
+static int      ps5_in_count;
+static uint32_t ps5_in_pos; // 16.16 position in ps5_in
+
+// pull frames from the engine DMA ring (lock held)
+static void PS5_PullFrames( int frames )
+{
+	const int ring = snd.samples; // in samples (frames * 2)
+	short *src = (short *)snd.buffer;
+
+	if( ps5_in_count + frames > PS5_IN_MAX )
+		frames = PS5_IN_MAX - ps5_in_count;
+
+	for( int i = 0; i < frames; i++ )
+	{
+		if( snd.samplepos >= ring )
+			snd.samplepos = 0;
+		ps5_in[ps5_in_count][0] = src[snd.samplepos];
+		ps5_in[ps5_in_count][1] = src[snd.samplepos + 1];
+		snd.samplepos += 2;
+		ps5_in_count++;
+	}
+	if( snd.samplepos >= ring )
+		snd.samplepos = 0;
+}
+
+static void PS5_FillBlock( void )
+{
+	pthread_mutex_lock( &ps5_audio_lock );
+
+	if( !ps5_audio_active || !snd.buffer || snd.samples <= 0 )
+	{
+		memset( ps5_audio_block, 0, sizeof( ps5_audio_block ));
+		pthread_mutex_unlock( &ps5_audio_lock );
+		return;
+	}
+
+	for( int i = 0; i < PS5_AUDIO_GRAIN; i++ )
+	{
+		int k = ps5_in_pos >> 16;
+		int f = ps5_in_pos & 0xffff;
+
+		while( k + 1 >= ps5_in_count )
+			PS5_PullFrames( 64 );
+
+		for( int c = 0; c < 2; c++ )
+		{
+			int a = ps5_in[k][c], b = ps5_in[k + 1][c];
+			ps5_audio_block[i * 2 + c] = (short)( a + ((( b - a ) * f ) >> 16 ));
+		}
+		ps5_in_pos += PS5_RS_STEP;
+	}
+
+	{
+		int drop = ps5_in_pos >> 16;
+		if( drop > ps5_in_count )
+			drop = ps5_in_count;
+		memmove( ps5_in, ps5_in[drop], ( ps5_in_count - drop ) * sizeof( ps5_in[0] ));
+		ps5_in_count -= drop;
+		ps5_in_pos -= (uint32_t)drop << 16;
+	}
+
+	pthread_mutex_unlock( &ps5_audio_lock );
+}
+
+static void *PS5_AudioThread( void *arg )
+{
+	(void)arg;
+
+	while( ps5_audio_running )
+	{
+		PS5_FillBlock();
+
+		// blocks until the hardware consumed the previous grain (paces us at 48 kHz)
+		if( sceAudioOutOutput( ps5_audio_handle, ps5_audio_block ) < 0 )
+			break;
+	}
+
+	return NULL;
+}
+
+qboolean SNDDMA_Init( void )
+{
+	static int audio_inited;
+	int samplecount, ret;
+	int volumes[8];
+
+	if( !audio_inited )
+	{
+		ret = sceAudioOutInit();
+		// a second init reports "already initialised"; the first one is what matters
+		audio_inited = 1;
+		if( ret < 0 )
+			Con_Reportf( "Audio: sceAudioOutInit returned 0x%x (continuing)\n", ret );
+	}
+
+	ps5_audio_handle = sceAudioOutOpen( PS5_AUDIO_USER_SYSTEM, PS5_AUDIO_TYPE_MAIN, 0,
+		PS5_AUDIO_GRAIN, PS5_AUDIO_RATE, PS5_AUDIO_S16_STEREO );
+
+	if( ps5_audio_handle < 0 )
+	{
+		Con_Printf( S_ERROR "Audio: sceAudioOutOpen failed 0x%x\n", ps5_audio_handle );
+		ps5_audio_handle = -1;
+		return false;
+	}
+
+	for( int i = 0; i < 8; i++ )
+		volumes[i] = PS5_AUDIO_VOLUME_0DB;
+	sceAudioOutSetVolume( ps5_audio_handle, 3, volumes ); // left | right
+
+	snd.format.speed    = PS5_MIX_RATE; // resampled to 48 kHz in PS5_FillBlock
+	snd.format.channels = 2;
+	snd.format.width    = 2;
+	samplecount = s_samplecount.value;
+	if( !samplecount )
+		samplecount = 0x2000; // ~170 ms ring at 48 kHz: low latency, still safe
+	snd.samples   = samplecount * 2;
+	snd.buffer    = Mem_Calloc( sndpool, snd.samples * 2 );
+	snd.samplepos = 0;
+	ps5_in_count = 0;
+	ps5_in_pos = 0;
+
+	snd.initialized  = true;
+	snd.backend_name = "PS5 AudioOut";
+
+	ps5_audio_active = 1;
+	ps5_audio_running = 1;
+	if( pthread_create( &ps5_audio_thread, NULL, PS5_AudioThread, NULL ) != 0 )
+	{
+		Con_Printf( S_ERROR "Audio: can't create feeder thread\n" );
+		ps5_audio_running = 0;
+		SNDDMA_Shutdown();
+		return false;
+	}
+
+	Con_Printf( "Using PS5 AudioOut: mix %d Hz -> out %d Hz, %d-frame grain\n", PS5_MIX_RATE, PS5_AUDIO_RATE, PS5_AUDIO_GRAIN );
+	return true;
+}
+
+void SNDDMA_BeginPainting( void )
+{
+	pthread_mutex_lock( &ps5_audio_lock );
+}
+
+void SNDDMA_Submit( void )
+{
+	pthread_mutex_unlock( &ps5_audio_lock );
+}
+
+void SNDDMA_Activate( qboolean active )
+{
+	ps5_audio_active = active ? 1 : 0;
+}
+
+void SNDDMA_Shutdown( void )
+{
+	Con_Printf( "Shutting down audio.\n" );
+	snd.initialized = false;
+
+	if( ps5_audio_running )
+	{
+		ps5_audio_running = 0;
+		pthread_join( ps5_audio_thread, NULL );
+	}
+
+	if( ps5_audio_handle >= 0 )
+	{
+		sceAudioOutOutput( ps5_audio_handle, NULL ); // drain
+		sceAudioOutClose( ps5_audio_handle );
+		ps5_audio_handle = -1;
+	}
+
+	if( snd.buffer )
+	{
+		Mem_Free( snd.buffer );
+		snd.buffer = NULL;
+	}
+}
+
+// no microphone support
+qboolean VoiceCapture_Init( void ) { return false; }
+qboolean VoiceCapture_Activate( qboolean activate ) { (void)activate; return false; }
+qboolean VoiceCapture_Lock( qboolean lock ) { (void)lock; return false; }
+void VoiceCapture_Shutdown( void ) { }
+
+#endif // XASH_PS5
diff --git a/engine/platform/ps5/sys_ps5.c b/engine/platform/ps5/sys_ps5.c
new file mode 100644
index 0000000..6029649
--- /dev/null
+++ b/engine/platform/ps5/sys_ps5.c
@@ -0,0 +1,101 @@
+/*
+sys_ps5.c - PS5 homebrew platform backend
+Copyright (C) 2026
+
+This program is free software: you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation, either version 3 of the License, or
+(at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+---
+
+Target stack (verified against upstream repos, 2026-10-03):
+  - toolchain + libc:  ps5-payload-dev/sdk  (clang/lld, real libc, native
+    folder-app packaging via ps5-native-app-boilerplate)
+  - GL:                blackbearreloaded/ps5-opengl (OpenGL 4.6 Core / EGL,
+    Mesa+Gallium backed, CTS-passing) with its SDL2 video driver "G19"
+    (integration/SDL2/SDL_ps5g19.c) -- this is what lets Xash3D reuse its
+    existing engine/platform/sdl2 + ref/gl backends almost unmodified.
+  - Vulkan (future):   mihawk-99/PS5_Vulkan + PS5_Mesa (RADV port). Not
+    targeted by this first pass -- ref/gl (OpenGL) is the nearer path given
+    the existing Xash3D GL renderer and the SDL2 bridge above.
+
+This file intentionally stays thin: most logic should live in
+engine/platform/sdl2/*.c once the SDL2 "G19" driver is linked in for
+DEST_OS == 'ps5'. Anything here is for PS5-only concerns that have no SDL
+equivalent (base path resolution inside the native app folder, and any
+console-specific lifecycle hooks the native app boilerplate requires).
+*/
+
+#include "platform/platform.h"
+
+#if XASH_PS5
+
+#include <stdio.h>
+#include <string.h>
+
+/*
+========================
+PS5_Init
+
+Called once from Host code at startup, before the SDL2 video/audio
+backends are brought up. On PS5 this is where we'd register with the
+native app boilerplate's lifecycle (suspend/resume callbacks) once that
+integration is written; left as a stub until the boilerplate headers are
+wired into the build.
+========================
+*/
+void PS5_Init( void )
+{
+	// TODO: hook ps5-native-app-boilerplate lifecycle (suspend/resume),
+	// once Makefile/toolchain integration lands.
+}
+
+/*
+========================
+PS5_Shutdown
+========================
+*/
+void PS5_Shutdown( void )
+{
+}
+
+/*
+========================
+PS5_GetBasePath
+
+Native folder apps on PS5 run from a fixed, read-only app0-style mount
+(see ps5-opengl docs/consumer-build.md: titles are uploaded to
+/data/homebrew/<TITLEID> and launched as a registered title, not an ELF
+payload). Until the boilerplate's path helpers are wired in, hardcode the
+expected layout; this must be revisited once the native app boilerplate
+integration is in place.
+========================
+*/
+qboolean PS5_GetBasePath( char *buf, const size_t buflen )
+{
+	// Native folder apps are launched with their title's package mounted
+	// read-only at /app0 (confirmed against ps5-native-app-boilerplate's
+	// docs/PLATFORM_NOTES.md: "/app0 is the read-only application image").
+	// The earlier placeholder, "/data/homebrew/current", does not exist on
+	// a real console (ShadowMountPlus mounts titles under
+	// /system_ex/app/<TITLEID>, not a stable "current" alias) -- Xash3D's
+	// filesystem layer would fail to find valve/ under that bogus path.
+	// /app0 (package, read-only) is passed as the read-only root instead
+	// (see FS_DetermineReadOnlyRootDirectory); the writable root is the
+	// per-title /download0 mount (downloadDataSize > 0 in param.json), so
+	// config.cfg, saves and logs can be written.
+	Q_strncpy( buf, "/download0", buflen );
+	return true;
+}
+
+/* Override ps5-opengl app_heap.c's weak 128 MiB default: Xash3D + Half-Life
+ * data needs far more; >128 MiB is served from CPU-cached direct memory. */
+const size_t ps5_opengl_heap_size = 1024u * 1024u * 1024u;
+
+#endif // XASH_PS5
