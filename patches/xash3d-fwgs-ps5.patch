diff --git a/scripts/ps5-bss-symbols.ld b/scripts/ps5-bss-symbols.ld
new file mode 100644
index 0000000..f8d52a6
--- /dev/null
+++ b/scripts/ps5-bss-symbols.ld
@@ -0,0 +1,12 @@
+/* Weak bss/image-end bookkeeping symbols referenced by libc/crt startup
+ * code on this target. ps5-pie.ld doesn't define a symbol exactly named
+ * __bss_start/__bss_end/__image_end, and lld's --version-script rejects
+ * assigning "local" visibility to an undefined symbol -- so the compiled
+ * weak references leaked into the dynamic symbol table and the PS5
+ * packaging tool then demanded a public SDK stub for them. Provide real
+ * (weak) definitions here instead, pointing at the actual .bss bounds.
+ */
+PROVIDE(__bss_start = ADDR(.bss));
+PROVIDE(__bss_end = ADDR(.bss) + SIZEOF(.bss));
+PROVIDE(__image_end = ADDR(.bss) + SIZEOF(.bss));
+PROVIDE(__image_start = 0);
diff --git a/scripts/ps5-hide-internal-symbols.map b/scripts/ps5-hide-internal-symbols.map
new file mode 100644
index 0000000..97b73d1
--- /dev/null
+++ b/scripts/ps5-hide-internal-symbols.map
@@ -0,0 +1,23 @@
+/* PS5 homebrew packaging link helper.
+ *
+ * Mesa/libglapi (vendored via ps5-opengl's libPS5OpenGL.a) emits a handful
+ * of internal TLS-wrapper symbols (mangled as _ZTH*, e.g.
+ * _ZTH23_mesa_glapi_tls_Context) into the dynamic symbol table even on a
+ * final executable, not just a shared object. They have no legitimate
+ * external caller and -Wl,--exclude-libs=ALL does not catch them (they
+ * aren't plain exported library symbols, they're compiler-generated TLS
+ * init wrappers), so the PS5 native packaging tool
+ * (ps5-native-tool/sce_module_writer.cpp) refuses to link because no
+ * public SDK stub can "provide" them. Force them local explicitly.
+ */
+{
+	local:
+		_ZTH*;
+		__dlopen;
+		__dlsym;
+		__dladdr;
+		__dlclose;
+		__dlerror;
+		_Zn*;
+		_Zd*;
+};
