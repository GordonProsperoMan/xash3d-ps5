diff --git a/regamedll/public/FileSystem.cpp b/regamedll/public/FileSystem.cpp
index 3b0f033..5f57f10 100644
--- a/regamedll/public/FileSystem.cpp
+++ b/regamedll/public/FileSystem.cpp
@@ -31,8 +31,21 @@
 IFileSystem *g_pFileSystem = nullptr;
 CSysModule *g_pFileSystemModule = nullptr;
 
+#if defined(__PROSPERO__)
+// PS5: no dlopen; the engine links filesystem_stdio statically and exposes
+// its CreateInterface (engine/platform/misc/lib_static.c)
+extern "C" void *ps5_filesystem_create_interface();
+#endif
+
 bool FileSystem_Init()
 {
+#if defined(__PROSPERO__)
+	CreateInterfaceFn ps5Factory = (CreateInterfaceFn)ps5_filesystem_create_interface();
+	if (!ps5Factory)
+		return false;
+	g_pFileSystem = (IFileSystem *)ps5Factory(FILESYSTEM_INTERFACE_VERSION, nullptr);
+	return g_pFileSystem != nullptr;
+#endif
 	g_pFileSystemModule = Sys_LoadModule(STDIO_FILESYSTEM_LIB);
 	if (!g_pFileSystemModule)
 	{
